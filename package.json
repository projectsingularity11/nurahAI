{
  "name": "nurah-ai",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:web": "expo export -p web",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:web",
    "test:e2e": "playwright test",
    "preview:web": "node scripts/serve-web.cjs",
    "format": "prettier --write app src tests e2e scripts *.js *.ts *.json README.md TASKS.md",
    "format:check": "prettier --check app src tests e2e scripts *.js *.ts *.json README.md TASKS.md"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.99.1",
    "adhan": "4.4.3",
    "expo": "~57.0.28",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.56.1",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.15",
    "eslint": "9.39.4",
    "eslint-config-expo": "~57.0.2",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
